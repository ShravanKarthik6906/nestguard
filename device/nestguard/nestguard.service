[Unit]
Description=NestGuard device
After=network-online.target
Wants=network-online.target

[Service]
User=nest
WorkingDirectory=/home/nest/nestguard
# Change this to the backend's address (laptop IP for now, Vultr URL later)
Environment=NESTGUARD_API=http://192.168.1.50:8000
Environment=NESTGUARD_CHECK_PATH=/check
Environment=NESTGUARD_LCD_ADDR=0x27
ExecStart=/home/nest/nestguard/venv/bin/python /home/nest/nestguard/nestguard.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
